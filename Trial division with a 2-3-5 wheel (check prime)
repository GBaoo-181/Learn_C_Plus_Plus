#include <bits/stdc++.h>
using namespace std;

bool checknt(long long n) {
    if (n == 2 || n == 3) return true;
    if (n < 3 || n % 2 == 0 || n % 3 == 0) return false;
    for (int i = 5; i * i <= n; i += 6)
        if (n % i == 0 || n % (i + 2) == 0) return false;
    return true;
}

int main() {


    int x;
    cin >> x;
    if(checknt(x)) cout << x << ' ';
    return 0;
}
